    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@netlify/plugin-nextjs": "^5.16.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "simple-icons": "^16.37.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
